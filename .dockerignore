# ── .dockerignore ───────────────────────────────────────────────
# Fichiers exclus du build context Docker
# ────────────────────────────────────────────────────────────────

# Données brutes et traitées (volumineuses, inutiles dans l'image)
data/

# Notebooks Jupyter
notebooks/

# Git
.git/
.gitignore
.gitattributes

# Environnements virtuels Python
venv/
.venv/
env/

# Cache Python
__pycache__/
*.py[cod]
*.pyo

# Variables d'environnement sensibles
.env
.env.*

# Assets et documentation (inutiles en production)
assets/
*.md
report.pdf
slides.ppt*

# Fichiers système
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.code-workspace